{
  "manifest_version": 3,
  "name": "XContest Data Collector",
  "version": "2.0.0",
  "description": "Автоматический сбор данных полетов с XContest.org API",
  "permissions": [
    "storage",
    "webRequest",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://www.xcontest.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xcontest.org/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XContest Data Collector",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "automation.js", "automation-manager.js"],
      "matches": ["https://www.xcontest.org/*"]
    }
  ]
}
