{
  "manifest_version": 3,
  "name": "Paraplan Leonardo IGC Helper",
  "version": "0.1.0",
  "description": "Collects Leonardo flight links and downloads IGC files from paraplan.ru",
  "permissions": ["storage", "downloads", "scripting", "activeTab"],
  "host_permissions": [
    "https://paraplan.ru/*",
    "http://paraplan.ru/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "IGC Helper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
