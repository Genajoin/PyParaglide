# Paraglidable Environment Variables
# Copy this file to .env and adjust values as needed
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your settings
#   source .env  # or use direnv / export manually
#
# CLI Usage:
#   python scripts/cli.py ingest list --years 2020-2025
#   python scripts/cli.py stats monthly --group-by quarter
#   python scripts/cli.py --help

# =============================================================================
# PostgreSQL Database (IGC flights storage)
# =============================================================================
# Connection URL used by scripts in scripts/ and CLI
# Default: connects to docker-compose postgres container
IGC_DB_URL=postgresql://paraglidable:paraglidable@paraglidable-postgres:5432/paraglidable

# Individual PostgreSQL components (alternative to IGC_DB_URL)
POSTGRES_USER=paraglidable
POSTGRES_PASSWORD=paraglidable
POSTGRES_DB=paraglidable
POSTGRES_HOST=paraglidable-postgres
POSTGRES_PORT=5432

# =============================================================================
# UCAR RDA (GFS Weather Data Download)
# =============================================================================
# Required for downloading GFS data from RDA (https://rda.ucar.edu/)
# Register at: https://rda.ucar.edu/accounts/signup/
#
# Used by: scripts/download_GFS_rda.py
UCAR_EMAIL=your-email@example.com
UCAR_PASS=your-rda-password

# =============================================================================
# Training Data Configuration
# =============================================================================
# Date ranges for training (YYYY-MM-DD:YYYY-MM-DD,YYYY-MM-DD:YYYY-MM-DD,...)
# Leave empty to use all available dates from PKL files
# Examples:
#   TRAINING_DATES=2021-06-01:2021-09-30
#   TRAINING_DATES=2021-06-01:2021-09-30,2022-06-01:2022-09-30
TRAINING_DATES=

# Geographic bounding box for filtering (lat_min,lat_max,lon_min,lon_max)
# Leave empty to use all cells from sorted_cells_latlon.pkl
# Example: TRAINING_BBOX=45,47,13,16  (Slovenia/northern Italy)
TRAINING_BBOX=

# Minimum flights per spot for SPOTS model training
MIN_FLIGHTS_PER_SPOT=200

# Spot clustering (merge nearby takeoffs within radius)
# Set to 0 to disable clustering
# Recommended: 2.0 km for Alpine regions
SPOT_CLUSTER_DISTANCE_KM=2.0

# Data directories (override defaults if needed)
PROJECT_ROOT=.  # Project root directory (auto-detected from scripts)
FLIGHTS_DIR=data/flights
PKL_DIR=neural_network/bin/data
GFS_DIR=data/gfs/anl
ELEVATION_DIR=tiler/_cache/elevation

# =============================================================================
# Optional: External Services
# =============================================================================
# Add any other API keys or service URLs below as needed


# =============================================================================
# Build Configuration (scripts/build_pkl_dataset.py)
# =============================================================================
# multiprocessing
BUILD_THREADS=2
# memory limit
BUILD_QUEUE_SIZE=3
