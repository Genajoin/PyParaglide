# Paraglidable Environment Variables
# Copy this file to .env and adjust values as needed
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your settings
#   source .env  # or use direnv / export manually
#
# CLI Usage:
#   python scripts/cli.py ingest list --years 2020-2025
#   python scripts/cli.py stats monthly --group-by quarter
#   python scripts/cli.py --help

# =============================================================================
# PostgreSQL Database (IGC flights storage)
# =============================================================================
# Connection URL used by scripts in scripts/ and CLI
# Default: connects to docker-compose postgres container
IGC_DB_URL=postgresql://paraglidable:paraglidable@paraglidable-postgres:5432/paraglidable

# Individual PostgreSQL components (alternative to IGC_DB_URL)
POSTGRES_USER=paraglidable
POSTGRES_PASSWORD=paraglidable
POSTGRES_DB=paraglidable
POSTGRES_HOST=paraglidable-postgres
POSTGRES_PORT=5432

# =============================================================================
# UCAR RDA (GFS Weather Data Download)
# =============================================================================
# Required for downloading GFS data from RDA (https://rda.ucar.edu/)
# Register at: https://rda.ucar.edu/accounts/signup/
#
# Used by: scripts/download_GFS_rda.py
UCAR_EMAIL=your-email@example.com
UCAR_PASS=your-rda-password

# =============================================================================
# Optional: External Services
# =============================================================================
# Add any other API keys or service URLs below as needed
