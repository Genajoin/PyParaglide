# PyParaglide Configuration Example
# Copy this file to .env and adjust values for your setup

# ============================================================================
# Geographic Bounds
# ============================================================================
# Bounding box following GeoJSON RFC 7946 format (lon_min,lat_min,lon_max,lat_max)
# Example: Alps region
PYPARAGLIDE_BBOX=13,45,15,47

# ============================================================================
# Data Directories
# ============================================================================
# Directory for GFS GRIB weather files
PYPARAGLIDE_GFS_DIR=data/gfs/anl

# Directory containing trained model weights
PYPARAGLIDE_MODELS_DIR=data/models

# Output directory for forecast results
PYPARAGLIDE_OUTPUT_DIR=output/forecasts

# Directory for flight data (xContest JSON files)
PYPARAGLIDE_FLIGHTS_DIR=data/flights

# Directory for elevation tiles
PYPARAGLIDE_ELEVATION_DIR=data/elevation

# Elevation data source: SRTM1 (30m) or SRTM3 (90m, default)
# SRTM3 recommended for most use cases (smaller download size)
PYPARAGLIDE_ELEVATION_SOURCE=SRTM3

# Auto-download elevation data if missing during build-dataset (default: true)
# Set to false to require manual download via 'pyparaglide download'
PYPARAGLIDE_ELEVATION_AUTO_DOWNLOAD=true

# Note: SRTM coverage limited to ±60° latitude
# Regions outside this range will be clipped

# ============================================================================
# Forecast Parameters
# ============================================================================
# Number of days to forecast (default: 10)
PYPARAGLIDE_FORECAST_DAYS=10

# ============================================================================
# Training Parameters
# ============================================================================
# Date ranges for training data (comma-separated)
# Format: YYYY-MM-DD:YYYY-MM-DD,YYYY-MM-DD:YYYY-MM-DD
# Example: Summer months from 2021-2023
PYPARAGLIDE_TRAINING_DATES=2021-06-01:2021-08-31,2022-06-01:2022-08-31,2023-06-01:2023-08-31

# Minimum number of flights required per spot for training (default: 200)
PYPARAGLIDE_MIN_FLIGHTS_PER_SPOT=200

# Minimum number of flights required per cell for training (default: 20)
# Filters out cells with sparse data to reduce label noise
# Set to 0 to disable cell filtering
PYPARAGLIDE_MIN_FLIGHTS_PER_CELL=800

# Spot clustering radius in kilometers (0 = disabled, default: 2.0)
PYPARAGLIDE_SPOT_CLUSTER_DISTANCE_KM=2.0

# ============================================================================
# Evaluation Parameters
# ============================================================================
# Default year for evaluate command and experiment test metrics
PYPARAGLIDE_EVALUATE_YEAR=2025

# Default threshold for evaluate command (0.0 - 1.0)
# Higher = more conservative (fewer false positives, more false negatives)
# Lower = more aggressive (more false positives, fewer false negatives)
PYPARAGLIDE_EVALUATE_THRESHOLD=0.1

# ============================================================================
# Processing
# ============================================================================
# Enable debug mode (keep temporary files, verbose output)
PYPARAGLIDE_DEBUG=false

# Number of parallel workers for data processing (default: 4)
PYPARAGLIDE_WORKERS=4
